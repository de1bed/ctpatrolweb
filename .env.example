# ============================================================================
# CTPatrol · Variables de entorno
#
# Copia este archivo a .env.local y llena los valores.
#
# REGLA: solo lo que lleva NEXT_PUBLIC_ llega al navegador. Todo lo demás
# vive únicamente en el servidor. Si una llave de pago aparece con el prefijo
# NEXT_PUBLIC_, cualquiera puede leerla desde las herramientas del navegador
# y gastarla. En el sistema anterior las cuatro llaves estaban expuestas así.
# ============================================================================

# ── Supabase (público: protegido por RLS) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xwkmfxxurcercpvrksyf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── Supabase (SECRETO: se salta RLS por completo) ───────────────────────────
# Solo para operaciones de servidor: dar de alta usuarios, escribir reportes.
# Se saca del panel: Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (SECRETO: correo transaccional) ──────────────────────────────────
# Altas, recuperación de contraseña y reportes de inspección.
# El dominio del FROM tiene que estar verificado en Resend.
RESEND_API_KEY=
RESEND_FROM=CTPatrol <inspecciones@vortexlabai.com>

# ── OpenAI (SECRETO) ────────────────────────────────────────────────────────
# Solo se usa desde /api. Nunca desde un componente de cliente.
OPENAI_API_KEY=

# Tope de gasto por inspección, en número de llamadas de visión.
# Evita que un bug en un loop se coma el presupuesto del mes.
OPENAI_MAX_CALLS_PER_INSPECTION=40

# ── App ─────────────────────────────────────────────────────────────────────
# OJO: esta URL se IMPRIME dentro del QR de verificación de cada reporte.
# Un valor incorrecto queda impreso en papel que ya salió de la oficina, y
# no hay forma de corregirlo después. En producción debe ser el dominio
# público real, con https.
NEXT_PUBLIC_APP_URL=http://localhost:3100
